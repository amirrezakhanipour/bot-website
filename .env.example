# Public Live Stream Configuration (YouTube Live)
NEXT_PUBLIC_LIVE_STREAM_PROVIDER=youtube
NEXT_PUBLIC_YOUTUBE_LIVE_VIDEO_ID=

# Server-only secrets are intentionally not named with NEXT_PUBLIC_.
